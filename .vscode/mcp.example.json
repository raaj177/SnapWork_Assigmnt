{
  "inputs": [
    {
      "id": "jenkinsAuth",
      "type": "promptString",
      "description": "Base64 of <jenkins-user>:<api-token>",
      "password": true
    }
  ],
  "servers": {
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "appium": {
      "command": "npx",
      "args": ["-y", "appium-mcp@latest"],
      "env": {
        "ANDROID_HOME": "<folder that contains platform-tools/adb>",
        "ANDROID_SDK_ROOT": "<same folder>"
      }
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "jenkins": {
      "type": "http",
      "url": "http://localhost:8080/mcp-server/mcp",
      "headers": {
        "Authorization": "Basic ${input:jenkinsAuth}"
      }
    }
  }
}
