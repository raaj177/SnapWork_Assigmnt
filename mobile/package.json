{
  "name": "snapwork-mobile",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "WebdriverIO + Appium (UiAutomator2) login automation for Sauce Labs My Demo App Android (US_LOGIN_001)",
  "scripts": {
    "setup": "appium driver install uiautomator2",
    "test": "wdio run wdio.conf.ts",
    "test:smoke": "wdio run wdio.conf.ts --mochaOpts.grep @smoke",
    "test:regression": "wdio run wdio.conf.ts --mochaOpts.grep @regression",
    "test:one": "wdio run wdio.conf.ts --mochaOpts.grep",
    "typecheck": "tsc --noEmit",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "report": "allure generate allure-results --clean -o allure-report && allure open allure-report"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@wdio/allure-reporter": "^9.0.0",
    "@wdio/appium-service": "^9.0.0",
    "@wdio/cli": "^9.0.0",
    "@wdio/globals": "^9.0.0",
    "@wdio/junit-reporter": "^9.0.0",
    "@wdio/local-runner": "^9.0.0",
    "@wdio/mocha-framework": "^9.0.0",
    "@wdio/spec-reporter": "^9.0.0",
    "allure-commandline": "^2.30.0",
    "appium": "^3.0.0",
    "appium-uiautomator2-driver": "^8.7.0",
    "dotenv": "^16.4.5",
    "expect-webdriverio": "^6.0.9",
    "typescript": "^5.6.0",
    "webdriverio": "^9.0.0"
  }
}
