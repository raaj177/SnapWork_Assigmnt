{
  "name": "snapwork",
  "version": "1.0.0",
  "private": true,
  "description": "QA automation assignment US_LOGIN_001: Playwright web suite and Appium mobile suite",
  "scripts": {
    "test:web": "playwright test",
    "test:web:smoke": "playwright test --grep @smoke",
    "test:web:sanity": "playwright test --grep @sanity",
    "test:web:regression": "playwright test --grep @regression",
    "test:web:cross-browser": "playwright test --grep @cross-browser --project=chromium --project=firefox --project=webkit",
    "test:web:headed": "playwright test --headed",
    "test:web:one": "playwright test --grep",
    "test:mobile": "npm --prefix mobile test",
    "test:mobile:smoke": "npm --prefix mobile run test:smoke",
    "test:all": "npm run test:web; web=$?; npm run test:mobile; mobile=$?; [ $web -eq 0 ] && [ $mobile -eq 0 ]",
    "test:all:smoke": "npm run test:web:smoke; web=$?; npm run test:mobile:smoke; mobile=$?; [ $web -eq 0 ] && [ $mobile -eq 0 ]",
    "typecheck": "tsc --noEmit",
    "report:web": "playwright show-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.0.0",
    "allure-commandline": "^2.30.0",
    "allure-playwright": "^3.0.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.6.0"
  }
}
